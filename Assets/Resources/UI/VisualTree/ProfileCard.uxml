<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/MobileUIStyle.uss?fileID=7433441132597879392&amp;guid=a1e1a68698a96804f95b29aa35db691e&amp;type=3#MobileUIStyle" />
    <engine:VisualElement name="notification" style="flex-grow: 0; width: 80px; height: 35px; border-top-left-radius: 10px; border-top-right-radius: 10px; background-color: rgb(57, 118, 242); position: absolute; flex-shrink: 0; right: 20px; flex-direction: row; align-items: center; justify-content: center; display: none;">
        <engine:VisualElement style="flex-grow: 0; width: 18px; height: 18px; flex-shrink: 0; background-image: resource(&apos;Vectors/Text Icons/eye&apos;); -unity-background-scale-mode: scale-to-fit;" />
        <engine:Label text="AR" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/Pretendard-SemiBold.otf?fileID=12800000&amp;guid=c5f2f18448a7a8340af7b5afdab1df03&amp;type=3#Pretendard-SemiBold&quot;); font-size: 12px; margin-bottom: 6px;" />
    </engine:VisualElement>
    <engine:VisualElement name="card" focusable="true" class="card" style="flex-grow: 1; border-top-left-radius: 20px; border-top-right-radius: 20px; border-bottom-right-radius: 20px; border-bottom-left-radius: 20px; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-left-color: rgba(255, 255, 255, 0.54); border-right-color: rgba(255, 255, 255, 0.54); border-top-color: rgba(255, 255, 255, 0.54); border-bottom-color: rgba(255, 255, 255, 0.54); width: 100%; height: 100%; padding-top: 20px; padding-right: 20px; padding-bottom: 20px; padding-left: 20px; margin-bottom: 8px; transition-duration: 0.2s;">
        <engine:VisualElement name="header" style="flex-grow: 1; flex-direction: row; align-items: center;">
            <engine:VisualElement name="photo" style="flex-grow: 0; width: 40px; height: 40px; background-color: rgb(0, 0, 0); flex-shrink: 0; border-top-left-radius: 20px; border-top-right-radius: 20px; border-bottom-right-radius: 20px; border-bottom-left-radius: 20px; margin-right: 10px; background-image: resource(&apos;Vectors/Text Icons/goggle&apos;); -unity-background-scale-mode: scale-to-fit;">
                <engine:VisualElement name="status" style="flex-grow: 1; position: absolute; right: 0; bottom: 0; width: 13px; height: 13px; border-top-left-radius: 7.5px; border-top-right-radius: 7.5px; border-bottom-right-radius: 7.5px; border-bottom-left-radius: 7.5px; background-image: resource(&apos;Vectors/Icons/state_online_small&apos;);" />
            </engine:VisualElement>
            <engine:VisualElement name="description" style="flex-grow: 1;">
                <engine:Label text="권가경" name="name" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/Pretendard-SemiBold.otf?fileID=12800000&amp;guid=c5f2f18448a7a8340af7b5afdab1df03&amp;type=3#Pretendard-SemiBold&quot;); font-size: 18px; margin-bottom: 0; margin-top: 0;" />
                <engine:Label text="기관명 도식" name="job" style="font-size: 12px; margin-bottom: 0;" />
            </engine:VisualElement>
            <engine:VisualElement name="wish" style="flex-grow: 0; flex-shrink: 0; background-image: resource(&apos;Vectors/Icons/heart&apos;); width: 20px; height: 20px; -unity-background-scale-mode: scale-to-fit; position: absolute; top: 0; right: 0; visibility: hidden;" />
            <engine:VisualElement name="wish-blank" style="flex-grow: 0; flex-shrink: 0; background-image: resource(&apos;Vectors/Icons/heart-light&apos;); width: 20px; height: 20px; -unity-background-scale-mode: scale-to-fit; position: absolute; top: 0; right: 0; visibility: hidden;" />
        </engine:VisualElement>
        <engine:VisualElement name="keywords-container" style="flex-grow: 1; flex-direction: row;" />
        <engine:VisualElement name="interests-container" style="flex-grow: 1; flex-direction: row;" />
        <engine:Button text="만나러 가기" name="meet-button" focusable="false" class="button" style="margin-top: 17px; display: none; transition-property: all, opacity; transition-duration: 0.1s, 0.3s; transition-timing-function: ease-in, ease-in; transition-delay: 0s, 0s;" />
    </engine:VisualElement>
</engine:UXML>
