<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/MobileUIStyle.uss?fileID=7433441132597879392&amp;guid=a1e1a68698a96804f95b29aa35db691e&amp;type=3#MobileUIStyle" />
    <engine:VisualElement name="card" style="flex-grow: 0; background-color: rgb(59, 64, 73); border-top-left-radius: 40px; border-top-right-radius: 40px; border-bottom-right-radius: 40px; border-bottom-left-radius: 40px; padding-top: 20px; padding-right: 20px; padding-bottom: 20px; padding-left: 20px; width: auto; height: 80px; flex-direction: row; align-items: center; flex-shrink: 0; margin-top: 10px; margin-right: 10px; margin-bottom: 10px; margin-left: 10px;">
        <engine:VisualElement name="icon" style="flex-grow: 0; width: 30px; height: 30px; flex-shrink: 0; background-image: resource(&apos;Vectors/Icons/union&apos;); -unity-background-scale-mode: scale-to-fit; margin-right: 10px;" />
        <engine:VisualElement name="detail" style="flex-grow: 1; justify-content: center;">
            <engine:Label text="하계 학술대회 논문" name="title" style="font-size: 18px; -unity-font-definition: url(&quot;project://database/Assets/Fonts/Pretendard-SemiBold.otf?fileID=12800000&amp;guid=c5f2f18448a7a8340af7b5afdab1df03&amp;type=3#Pretendard-SemiBold&quot;); margin-bottom: 0;" />
            <engine:Label text="www.naver.com" name="link" style="color: rgba(255, 255, 255, 0.78); margin-top: 0; margin-bottom: 6px;" />
        </engine:VisualElement>
    </engine:VisualElement>
</engine:UXML>
