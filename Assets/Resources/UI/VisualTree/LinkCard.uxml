<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/MobileUIStyle.uss?fileID=7433441132597879392&amp;guid=a1e1a68698a96804f95b29aa35db691e&amp;type=3#MobileUIStyle" />
    <engine:VisualElement name="card" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0.46); border-top-left-radius: 40px; border-top-right-radius: 40px; border-bottom-right-radius: 40px; border-bottom-left-radius: 40px; padding-top: 20px; padding-right: 20px; padding-bottom: 20px; padding-left: 20px; border-left-color: rgba(255, 255, 255, 0.54); border-right-color: rgba(255, 255, 255, 0.54); border-top-color: rgba(255, 255, 255, 0.54); border-bottom-color: rgba(255, 255, 255, 0.54); width: 100%; height: 100%; flex-direction: row;">
        <engine:VisualElement name="icon" style="flex-grow: 0; width: 36px; height: 36px; flex-shrink: 0; background-color: rgb(0, 0, 0);" />
        <engine:VisualElement name="detail" style="flex-grow: 1; justify-content: center;">
            <engine:Label text="하계 학술대회 논문" name="title" style="font-size: 18px;" />
            <engine:Label text="www.naver.com" name="link" />
        </engine:VisualElement>
    </engine:VisualElement>
</engine:UXML>
