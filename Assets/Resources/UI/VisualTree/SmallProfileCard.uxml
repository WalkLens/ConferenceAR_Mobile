<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/MobileUIStyle.uss?fileID=7433441132597879392&amp;guid=a1e1a68698a96804f95b29aa35db691e&amp;type=3#MobileUIStyle" />
    <engine:VisualElement name="card" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0.46); border-top-left-radius: 20px; border-top-right-radius: 20px; border-bottom-right-radius: 20px; border-bottom-left-radius: 20px; padding-top: 20px; padding-right: 20px; padding-bottom: 20px; padding-left: 20px; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-left-color: rgba(255, 255, 255, 0.54); border-right-color: rgba(255, 255, 255, 0.54); border-top-color: rgba(255, 255, 255, 0.54); border-bottom-color: rgba(255, 255, 255, 0.54); width: 100%; height: 100%;">
        <engine:VisualElement name="close-button" style="flex-grow: 0; flex-shrink: 0; width: 20px; height: 20px; position: absolute; right: 0; top: 0; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; background-color: rgb(0, 0, 0);" />
        <engine:VisualElement name="profile-photo" style="flex-grow: 0; width: 40px; height: 40px; background-color: rgb(0, 0, 0); flex-shrink: 0; border-top-left-radius: 20px; border-top-right-radius: 20px; border-bottom-right-radius: 20px; border-bottom-left-radius: 20px;">
            <engine:VisualElement name="status" style="flex-grow: 0; width: 12px; height: 12px; flex-shrink: 0; position: absolute; right: 0; bottom: 0; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); border-top-left-radius: 6px; border-top-right-radius: 6px; border-bottom-right-radius: 6px; border-bottom-left-radius: 6px; background-color: rgb(22, 229, 119);" />
        </engine:VisualElement>
        <engine:Label text="신영환" name="name" style="-unity-text-align: upper-center;" />
    </engine:VisualElement>
</engine:UXML>
