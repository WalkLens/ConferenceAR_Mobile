<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/MobileUIStyle.uss?fileID=7433441132597879392&amp;guid=7603fa8d7f15c4b419b63a0e7ebb78f4&amp;type=3#MobileUIStyle" />
    <ui:VisualElement name="Container" style="width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0); background-image: none; align-items: center;">
        <ui:Label text="내가 관심있는 키워드를&#10;최대 3가지 선택해주세요" display-tooltip-when-elided="true" name="Header1" class="header" />
        <ui:VisualElement name="TabContainer" style="flex-direction: row; margin-top: 20%;">
            <ui:Button text="기획" display-tooltip-when-elided="true" name="InterestResearch" class="tab-button tab-button-selected" />
            <ui:Button text="디자인" display-tooltip-when-elided="true" name="InterestDesign" class="tab-button" />
            <ui:Button text="개발" display-tooltip-when-elided="true" name="InterestDev" class="tab-button" />
        </ui:VisualElement>
        <ui:VisualElement name="InterestBar" class="tab-bar" style="translate: -132% 0; margin-bottom: 10%; transition-duration: 0.1s;" />
        <ui:VisualElement name="InterestChipContainer" style="width: 300%; flex-direction: row; transition-duration: 0.2s; translate: 33% 0;">
            <ui:VisualElement name="ResearchChipContainer" style="width: 100%;">
                <ui:VisualElement name="InterestResearchChips" style="align-items: stretch; flex-direction: row; flex-wrap: wrap; justify-content: center; margin-left: 30px; margin-right: 30px; display: flex;" />
            </ui:VisualElement>
            <ui:VisualElement name="DesignChipContainer" style="width: 100%;">
                <ui:VisualElement name="InterestDesignChips" style="align-items: stretch; flex-direction: row; flex-wrap: wrap; justify-content: center; margin-left: 30px; margin-right: 30px; display: flex;" />
            </ui:VisualElement>
            <ui:VisualElement name="DevChipContainer" style="width: 100%;">
                <ui:VisualElement name="InterestDevChips" style="align-items: stretch; flex-direction: row; flex-wrap: wrap; justify-content: center; margin-left: 30px; margin-right: 30px; display: flex;" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
