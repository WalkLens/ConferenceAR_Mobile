<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/MobileUIStyle.uss?fileID=7433441132597879392&amp;guid=7603fa8d7f15c4b419b63a0e7ebb78f4&amp;type=3#MobileUIStyle" />
    <ui:VisualElement name="Background" style="width: 100%; height: 100%; background-image: url(&apos;project://database/Assets/UI%20Toolkit/Background.png?fileID=2800000&amp;guid=52c0097855a73734a953f8b931869c47&amp;type=3#Background&apos;); -unity-background-scale-mode: scale-and-crop; position: absolute;" />
    <ui:VisualElement name="SearchBar" style="width: 100%; height: 43px; margin-top: 43px; flex-direction: row; position: absolute;">
        <ui:VisualElement name="Back" style="width: 43px; height: 43px; justify-content: center; align-items: center; flex-shrink: 0;">
            <ui:VisualElement style="position: absolute; width: 14.5px; rotate: 45deg; transform-origin: left; height: 1.7px; background-color: rgb(255, 255, 255); border-top-left-radius: 1px; border-bottom-left-radius: 1px; border-top-right-radius: 1px; border-bottom-right-radius: 1px;" />
            <ui:VisualElement style="position: absolute; width: 14.5px; transform-origin: left; rotate: -45deg; height: 1.7px; background-color: rgb(255, 255, 255); border-top-left-radius: 1px; border-bottom-left-radius: 1px; border-top-right-radius: 1px; border-bottom-right-radius: 1px;" />
        </ui:VisualElement>
        <ui:TextField picking-mode="Ignore" label="Text Field" value="| Name, Team etc..." text="| Name, Team etc..." name="Search" style="-unity-font-style: normal; color: rgb(255, 255, 255); align-items: center; flex-grow: 1; padding-left: 5px; padding-right: 5px; padding-top: 0; padding-bottom: 0; height: 43px;">
            <ui:IMGUIContainer name="SearchIcon" style="width: 24px; height: 24px; position: relative; right: 0; background-color: rgb(0, 0, 0); margin-right: 5px;" />
        </ui:TextField>
    </ui:VisualElement>
</ui:UXML>
