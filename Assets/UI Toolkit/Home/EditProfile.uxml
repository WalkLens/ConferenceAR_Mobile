<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/MobileUIStyle.uss?fileID=7433441132597879392&amp;guid=a1e1a68698a96804f95b29aa35db691e&amp;type=3#MobileUIStyle" />
    <ui:VisualElement name="Content" style="width: 100%; height: 100%; background-image: url(&quot;project://database/Assets/UI%20Toolkit/Background.png?fileID=2800000&amp;guid=d9183688c3cc8dc4a933373d8614e8be&amp;type=3#Background&quot;); -unity-background-scale-mode: scale-and-crop; position: absolute; -unity-font: url(&apos;project://database/Assets/Fonts_Mobile/Mobile_Pretendard-Regular.otf?fileID=12800000&amp;guid=a89cdade1f1a94c4d95268c2759459a5&amp;type=3#Mobile_Pretendard-Regular&apos;); -unity-font-definition: initial; align-items: center;">
        <ui:VisualElement name="Header" style="height: 60px; flex-shrink: 0; width: 100%; flex-direction: row; justify-content: center; align-items: center;">
            <ui:IMGUIContainer name="Prev" style="width: 30px; height: 30px; position: absolute; left: 30px; background-color: rgba(0, 0, 0, 0.94);" />
            <ui:Label text="프로필 수정" display-tooltip-when-elided="true" name="Header" style="font-size: 18px; -unity-font: url(&apos;project://database/Assets/Fonts_Mobile/Mobile_Pretendard-SemiBold.otf?fileID=12800000&amp;guid=7d44473115e622a4ea5717417f60c41d&amp;type=3#Mobile_Pretendard-SemiBold&apos;);" />
        </ui:VisualElement>
        <ui:VisualElement name="ProfileContainer" class="visiblecontainer" style="flex-shrink: 0;">
            <ui:VisualElement name="PhotoName" style="align-items: center; flex-direction: row;">
                <ui:IMGUIContainer style="width: 40px; height: 40px; border-top-left-radius: 20px; border-bottom-left-radius: 20px; border-top-right-radius: 20px; border-bottom-right-radius: 20px; background-image: url(&apos;project://database/Assets/Photon/PhotonUnityNetworking/Icons/PunIconApp32.png?fileID=2800000&amp;guid=436c5e63723127948af8857e903f658a&amp;type=3#PunIconApp32&apos;); flex-shrink: 0;" />
                <ui:VisualElement>
                    <ui:Label text="권하경" display-tooltip-when-elided="true" name="Name" style="font-size: 22px; -unity-font: url(&apos;project://database/Assets/Fonts_Mobile/Mobile_Pretendard-SemiBold.otf?fileID=12800000&amp;guid=7d44473115e622a4ea5717417f60c41d&amp;type=3#Mobile_Pretendard-SemiBold&apos;); -unity-font-definition: url(&quot;project://database/Assets/Fonts/Pretendard-SemiBold.otf?fileID=12800000&amp;guid=c5f2f18448a7a8340af7b5afdab1df03&amp;type=3#Pretendard-SemiBold&quot;);" />
                    <ui:Label text="기관명 도식" display-tooltip-when-elided="true" name="Introduction" style="color: rgba(255, 255, 255, 0.69); font-size: 12px;" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="Details" class="visiblecontainer">
            <ui:VisualElement name="Introduction">
                <ui:VisualElement name="Header" style="flex-grow: 1; flex-direction: row;">
                    <ui:Label text="소개" display-tooltip-when-elided="true" style="font-size: 16px; -unity-font: url(&apos;project://database/Assets/Fonts_Mobile/Mobile_Pretendard-SemiBold.otf?fileID=12800000&amp;guid=7d44473115e622a4ea5717417f60c41d&amp;type=3#Mobile_Pretendard-SemiBold&apos;);" />
                    <ui:Button text="Button" name="Button" style="width: 40px; height: 40px; position: absolute; right: 0; background-color: rgb(255, 0, 0);" />
                </ui:VisualElement>
                <ui:VisualElement class="visiblecontainer">
                    <ui:Label text="안녕하세요 AI 시대 디자이너의 역할에 대해 이야기 나누고 싶어요!" display-tooltip-when-elided="true" />
