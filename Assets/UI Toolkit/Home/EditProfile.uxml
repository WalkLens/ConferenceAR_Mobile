            <ui:VisualElement name="Divider" class="divider" />
            <ui:VisualElement name="Interest">
                <ui:Label text="관심 키워드" display-tooltip-when-elided="true" style="font-size: 16px; -unity-font: url(&apos;project://database/Assets/Fonts_Mobile/Mobile_Pretendard-SemiBold.otf?fileID=12800000&amp;guid=7d44473115e622a4ea5717417f60c41d&amp;type=3#Mobile_Pretendard-SemiBold&apos;);" />
                <ui:VisualElement name="Chips" style="flex-grow: 1; flex-wrap: wrap; flex-direction: row;">
                    <ui:Button text="Button" class="chip" />
                    <ui:Button text="Button" class="chip" />
                    <ui:Button text="Button" class="chip" />
                    <ui:Button text="Button" class="chip" />
                    <ui:Button text="Button" class="chip" />
                    <ui:Button text="Button" class="chip" />
