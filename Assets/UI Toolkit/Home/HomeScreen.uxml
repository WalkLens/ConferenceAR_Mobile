<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/MobileUIStyle.uss?fileID=7433441132597879392&amp;guid=a1e1a68698a96804f95b29aa35db691e&amp;type=3#MobileUIStyle" />
    <ui:VisualElement name="Content" style="width: 100%; height: 100%; background-image: url(&quot;project://database/Assets/UI%20Toolkit/Background.png?fileID=2800000&amp;guid=d9183688c3cc8dc4a933373d8614e8be&amp;type=3#Background&quot;); -unity-background-scale-mode: scale-and-crop; position: absolute; -unity-font: url(&apos;project://database/Assets/Fonts_Mobile/Mobile_Pretendard-Regular.otf?fileID=12800000&amp;guid=a89cdade1f1a94c4d95268c2759459a5&amp;type=3#Mobile_Pretendard-Regular&apos;); -unity-font-definition: initial; align-items: center;">
        <ui:VisualElement name="SearchBar" class="visiblecontainer" style="height: 60px; flex-shrink: 0;" />
        <ui:VisualElement name="ProfileContainer" class="visiblecontainer" style="flex-shrink: 0;">
            <ui:VisualElement name="PhotoName" style="align-items: center;">
                <ui:IMGUIContainer style="width: 108px; height: 108px; border-top-left-radius: 54px; border-bottom-left-radius: 54px; border-top-right-radius: 54px; border-bottom-right-radius: 54px; background-image: url(&apos;project://database/Assets/Photon/PhotonUnityNetworking/Icons/PunIconApp32.png?fileID=2800000&amp;guid=436c5e63723127948af8857e903f658a&amp;type=3#PunIconApp32&apos;); flex-shrink: 0;" />
                <ui:Label text="권하경" display-tooltip-when-elided="true" name="Name" style="font-size: 20px; -unity-font: url(&apos;project://database/Assets/Fonts_Mobile/Mobile_Pretendard-SemiBold.otf?fileID=12800000&amp;guid=7d44473115e622a4ea5717417f60c41d&amp;type=3#Mobile_Pretendard-SemiBold&apos;); -unity-font-definition: initial;" />
                <ui:Label text="AI 시대에서 디자이너의 역할에 대해&#10;이야기 나누고 싶어요 :)" display-tooltip-when-elided="true" name="Introduction" style="-unity-text-align: upper-center; color: rgba(255, 255, 255, 0.69);" />
            </ui:VisualElement>
            <ui:VisualElement name="Keywords">
                <ui:VisualElement name="Keyword">
                    <ui:Label text="나의 키워드" display-tooltip-when-elided="true" style="-unity-font: url(&apos;project://database/Assets/Fonts_Mobile/Mobile_Pretendard-SemiBold.otf?fileID=12800000&amp;guid=7d44473115e622a4ea5717417f60c41d&amp;type=3#Mobile_Pretendard-SemiBold&apos;);" />
                    <ui:VisualElement name="KeywordChips" />
                </ui:VisualElement>
                <ui:VisualElement name="Interest">
                    <ui:Label text="관심 키워드" display-tooltip-when-elided="true" style="-unity-font: url(&apos;project://database/Assets/Fonts_Mobile/Mobile_Pretendard-SemiBold.otf?fileID=12800000&amp;guid=7d44473115e622a4ea5717417f60c41d&amp;type=3#Mobile_Pretendard-SemiBold&apos;);" />
                    <ui:VisualElement name="InterestChips" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="ButtonContainer" style="flex-direction: row; width: 90%; height: 100%;">
            <ui:VisualElement name="History" class="visiblecontainer" style="align-items: center; justify-content: center;">
                <ui:IMGUIContainer style="background-image: url(&quot;project://database/Assets/Vectors/location.svg?fileID=7388822144124034973&amp;guid=0a939d340e030da43856bbe83abec17a&amp;type=3#location&quot;); min-height: 100px; min-width: 100px; -unity-background-scale-mode: scale-to-fit;" />
                <ui:Label text="만남 기록" display-tooltip-when-elided="true" />
            </ui:VisualElement>
            <ui:VisualElement name="Likes" class="visiblecontainer" style="align-items: center; justify-content: center;">
                <ui:IMGUIContainer style="background-image: url(&quot;project://database/Assets/Vectors/location.svg?fileID=7388822144124034973&amp;guid=0a939d340e030da43856bbe83abec17a&amp;type=3#location&quot;); min-height: 100px; min-width: 100px; -unity-background-scale-mode: scale-to-fit;" />
                <ui:Label text="찜 목록" display-tooltip-when-elided="true" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Label text="&lt;color=white&gt;&lt;gradient=&quot;Homescreen&quot;&gt;Expand Your Horizons!&lt;/gradient&gt;&lt;/color&gt;" style="font-size: 18px; -unity-text-align: upper-center;" />
    </ui:VisualElement>
</ui:UXML>
