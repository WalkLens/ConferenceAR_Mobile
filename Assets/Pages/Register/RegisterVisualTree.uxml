        <ui:Instance template="5. RegisterCompleteScreen" name="5" class="app-main" />
        <ui:Instance template="6. SetPINScreen" name="6" class="app-main" />
        <ui:Instance template="7. ConnectDeviceScreen" name="7" class="app-main" />
    </ui:VisualElement>
    <ui:VisualElement name="PopupBackground" style="position: absolute; width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0.2); display: none;" />
    <ui:VisualElement name="Popup" style="width: 100%; height: auto; position: absolute; bottom: 0; background-color: rgb(123, 123, 123); border-top-left-radius: 56px; border-top-right-radius: 56px; background-image: none; -unity-background-scale-mode: scale-and-crop; padding-left: 27px; padding-right: 27px; padding-top: 11px; padding-bottom: 27px; align-items: center; display: none;">
        <ui:VisualElement name="Handle" style="width: 10%; height: 5px; background-color: rgba(255, 255, 255, 0.5); border-top-left-radius: 2.5px; border-bottom-left-radius: 2.5px; border-top-right-radius: 2.5px; border-bottom-right-radius: 2.5px; margin-bottom: 25px;" />
        <ui:Label text="자기소개" display-tooltip-when-elided="true" style="-unity-font-definition: initial; -unity-font: url(&apos;project://database/Assets/Fonts_Mobile/Mobile_Pretendard-SemiBold.otf?fileID=12800000&amp;guid=7d44473115e622a4ea5717417f60c41d&amp;type=3#Mobile_Pretendard-SemiBold&apos;); font-size: 16px; margin-bottom: 16px; width: 100%;" />
        <ui:TextField picking-mode="Ignore" label="Text Field" value="Lorem ipsum dolor sit amet, consectetuer adipiscing elit. Aenean commodo ligula eget dolor. Aenean massa." text="Lorem ipsum dolor sit amet, consectetuer adipiscing elit. Aenean commodo ligula eget dolor. Aenean massa." multiline="true" style="color: rgb(255, 255, 255); white-space: normal;" />
    </ui:VisualElement>
    <ui:VisualElement name="SubmitContainer" style="position: absolute; bottom: 50px; align-items: center; width: 100%; padding-left: 20px; padding-right: 20px;">
        <ui:Button text="다음으로" display-tooltip-when-elided="true" name="SubmitButton" class="button" />
    </ui:VisualElement>
</ui:UXML>
