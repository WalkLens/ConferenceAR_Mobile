    <Style src="project://database/Assets/UI%20Toolkit/MobileUIStyle.uss?fileID=7433441132597879392&amp;guid=7603fa8d7f15c4b419b63a0e7ebb78f4&amp;type=3#MobileUIStyle" />
    <ui:VisualElement name="Background" style="position: absolute; width: 100%; height: 100%; background-color: rgb(0, 0, 0); background-image: url(&apos;project://database/Assets/UI%20Toolkit/Background.png?fileID=2800000&amp;guid=52c0097855a73734a953f8b931869c47&amp;type=3#Background&apos;);" />
    <ui:VisualElement name="Content" style="width: auto; height: 100%; flex-direction: row; transition-duration: 0.2s; transition-timing-function: ease-out-circ;">
        <ui:Instance template="BasicInfoScreen" name="1" class="app-main" />
        <ui:Instance template="KeywordScreen" name="2" class="app-main" />
