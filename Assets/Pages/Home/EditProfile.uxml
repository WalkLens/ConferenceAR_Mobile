<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/MobileUIStyle.uss?fileID=7433441132597879392&amp;guid=a1e1a68698a96804f95b29aa35db691e&amp;type=3#MobileUIStyle" />
    <ui:VisualElement name="content" style="width: 100%; height: 100%; background-image: url(&quot;project://database/Assets/Resources/Background.png?fileID=2800000&amp;guid=d9183688c3cc8dc4a933373d8614e8be&amp;type=3#Background&quot;); -unity-background-scale-mode: scale-and-crop; position: absolute; -unity-font: url(&apos;project://database/Assets/Fonts_Mobile/Mobile_Pretendard-Regular.otf?fileID=12800000&amp;guid=a89cdade1f1a94c4d95268c2759459a5&amp;type=3#Mobile_Pretendard-Regular&apos;); -unity-font-definition: initial; align-items: center;">
        <ui:VisualElement name="nav" style="height: 60px; flex-shrink: 0; width: 100%; flex-direction: row; justify-content: center; align-items: center;">
            <ui:VisualElement name="prev-button" style="flex-grow: 0; flex-shrink: 0; width: 24px; height: 24px; position: absolute; left: 20px; background-image: resource(&apos;Vectors/Icons/back&apos;); -unity-background-scale-mode: scale-to-fit;" />
            <ui:Label text="프로필 수정" display-tooltip-when-elided="true" name="header" style="font-size: 18px; -unity-font: url(&apos;project://database/Assets/Fonts_Mobile/Mobile_Pretendard-SemiBold.otf?fileID=12800000&amp;guid=7d44473115e622a4ea5717417f60c41d&amp;type=3#Mobile_Pretendard-SemiBold&apos;); -unity-text-align: middle-center; -unity-font-definition: url(&quot;project://database/Assets/Fonts/Pretendard-SemiBold.otf?fileID=12800000&amp;guid=c5f2f18448a7a8340af7b5afdab1df03&amp;type=3#Pretendard-SemiBold&quot;);" />
        </ui:VisualElement>
        <ui:VisualElement name="profile-container" class="visiblecontainer" style="flex-shrink: 0; flex-direction: row; align-items: center;">
            <ui:VisualElement name="profile-photo" style="flex-grow: 0; width: 40px; height: 40px; flex-shrink: 0; border-top-left-radius: 20px; border-top-right-radius: 20px; border-bottom-right-radius: 20px; border-bottom-left-radius: 20px; background-image: resource(&apos;Vectors/Icons/camera&apos;); -unity-background-scale-mode: scale-to-fit;" />
            <ui:VisualElement name="profile-text">
                <ui:Label text="권하경" display-tooltip-when-elided="true" name="Name" style="font-size: 22px; -unity-font: url(&apos;project://database/Assets/Fonts_Mobile/Mobile_Pretendard-SemiBold.otf?fileID=12800000&amp;guid=7d44473115e622a4ea5717417f60c41d&amp;type=3#Mobile_Pretendard-SemiBold&apos;); -unity-font-definition: url(&quot;project://database/Assets/Fonts/Pretendard-SemiBold.otf?fileID=12800000&amp;guid=c5f2f18448a7a8340af7b5afdab1df03&amp;type=3#Pretendard-SemiBold&quot;);" />
                <ui:Label text="기관명 도식" display-tooltip-when-elided="true" name="Introduction" style="color: rgba(255, 255, 255, 0.69); font-size: 12px;" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="detail" class="visiblecontainer">
            <ui:VisualElement name="introduction">
                <ui:VisualElement name="header" style="flex-grow: 1; flex-direction: row;">
                    <ui:Label text="소개" display-tooltip-when-elided="true" name="header-label" style="font-size: 16px; -unity-font: url(&apos;project://database/Assets/Fonts_Mobile/Mobile_Pretendard-SemiBold.otf?fileID=12800000&amp;guid=7d44473115e622a4ea5717417f60c41d&amp;type=3#Mobile_Pretendard-SemiBold&apos;);" />
                    <ui:VisualElement name="edit-button" style="flex-grow: 0; flex-shrink: 0; width: 40px; height: 40px; border-top-left-radius: 20px; border-top-right-radius: 20px; border-bottom-right-radius: 20px; border-bottom-left-radius: 20px; background-color: rgba(0, 0, 0, 0.43); align-items: center; justify-content: center; position: absolute; right: 15px;">
                        <ui:VisualElement name="icon" style="flex-grow: 0; flex-shrink: 0; width: 20px; height: 20px; background-image: resource(&apos;Vectors/Icons/edit&apos;); -unity-background-scale-mode: scale-to-fit;" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="body" class="visiblecontainer">
                    <ui:Label text="안녕하세요 AI 시대 디자이너의 역할에 대해 이야기 나누고 싶어요!" display-tooltip-when-elided="true" name="introduction-label" style="white-space: normal;" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="divider" class="divider" />
            <ui:VisualElement name="keyword">
                <ui:Label text="내 키워드" display-tooltip-when-elided="true" name="header-label" style="font-size: 16px; -unity-font: url(&apos;project://database/Assets/Fonts_Mobile/Mobile_Pretendard-SemiBold.otf?fileID=12800000&amp;guid=7d44473115e622a4ea5717417f60c41d&amp;type=3#Mobile_Pretendard-SemiBold&apos;);" />
                <ui:VisualElement name="chip-container" style="flex-grow: 1; flex-wrap: wrap; flex-direction: row;">
                    <ui:Button text="Button" class="chip" />
                    <ui:Button text="Button" class="chip" />
                    <ui:Button text="Button" class="chip" />
                    <ui:Button text="Button" class="chip" />
                    <ui:Button text="Button" class="chip" />
                    <ui:Button text="Button" class="chip" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="divider" class="divider" />
            <ui:VisualElement name="interest">
                <ui:Label text="관심 키워드" display-tooltip-when-elided="true" name="header-label" style="font-size: 16px; -unity-font: url(&apos;project://database/Assets/Fonts_Mobile/Mobile_Pretendard-SemiBold.otf?fileID=12800000&amp;guid=7d44473115e622a4ea5717417f60c41d&amp;type=3#Mobile_Pretendard-SemiBold&apos;);" />
                <ui:VisualElement name="chip-container" style="flex-grow: 1; flex-wrap: wrap; flex-direction: row;">
                    <ui:Button text="Button" class="chip" />
                    <ui:Button text="Button" class="chip" />
                    <ui:Button text="Button" class="chip" />
                    <ui:Button text="Button" class="chip" />
                    <ui:Button text="Button" class="chip" />
                    <ui:Button text="Button" class="chip" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="divider" class="divider" />
            <ui:VisualElement name="URL">
                <ui:VisualElement name="header" style="flex-grow: 1; flex-direction: row;">
                    <ui:Label text="URL" display-tooltip-when-elided="true" name="header-label" style="font-size: 16px; -unity-font: url(&apos;project://database/Assets/Fonts_Mobile/Mobile_Pretendard-SemiBold.otf?fileID=12800000&amp;guid=7d44473115e622a4ea5717417f60c41d&amp;type=3#Mobile_Pretendard-SemiBold&apos;);" />
                    <ui:Label text="(선택)" display-tooltip-when-elided="true" name="header-label-small" style="font-size: 14px; -unity-font: url(&apos;scale-and-crop&apos;); color: rgb(143, 143, 143);" />
                </ui:VisualElement>
                <ui:VisualElement name="chip-container" style="flex-grow: 1; flex-wrap: wrap; flex-direction: row;">
                    <ui:Button text="Button" class="chip" />
                    <ui:Button text="Button" class="chip" />
                    <ui:Button text="Button" class="chip" />
                    <ui:Button text="Button" class="chip" />
                    <ui:Button text="Button" class="chip" />
                    <ui:Button text="Button" class="chip" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="modal-background" style="flex-grow: 0; position: absolute; flex-shrink: 0; width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0.31); display: none;" />
        <ui:VisualElement name="modal" style="flex-grow: 1; position: absolute; bottom: 0; width: 100%; background-color: rgb(0, 0, 0); border-top-left-radius: 20px; border-top-right-radius: 20px;">
            <ui:VisualElement name="modal-bar" style="flex-grow: 1; width: 40px; height: 5px; background-color: rgb(255, 255, 255); border-top-left-radius: 2.5px; border-top-right-radius: 2.5px; border-bottom-right-radius: 2.5px; border-bottom-left-radius: 2.5px; position: absolute; align-self: center; top: 10px;" />
            <ui:Label text="자기소개" name="modal-header" style="font-size: 16px; -unity-font-definition: url(&quot;project://database/Assets/Fonts/Pretendard-SemiBold.otf?fileID=12800000&amp;guid=c5f2f18448a7a8340af7b5afdab1df03&amp;type=3#Pretendard-SemiBold&quot;); margin-top: 29px;" />
            <ui:VisualElement name="modal-content" style="flex-grow: 1;">
                <ui:TextField label="Text Field" placeholder-text="자기소개~" name="introduction-textfield" style="height: 200px;" />
            </ui:VisualElement>
            <ui:Button text="저장하기" name="submit-button" class="button" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
