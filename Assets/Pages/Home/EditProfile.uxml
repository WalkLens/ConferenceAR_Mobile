                <ui:Label text="기관명 도식" display-tooltip-when-elided="true" name="Introduction" style="color: rgba(255, 255, 255, 0.69); font-size: 12px; margin-top: 3px; margin-right: 3px; margin-bottom: 3px; margin-left: 3px;" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="detail" class="visiblecontainer" style="padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;">
            <ui:VisualElement name="introduction" style="padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px;">
                <ui:VisualElement name="header" style="flex-grow: 1; flex-direction: row;">
                    <ui:Label text="소개" display-tooltip-when-elided="true" name="header-label" style="font-size: 16px; -unity-font: url(&apos;project://database/Assets/Fonts_Mobile/Mobile_Pretendard-SemiBold.otf?fileID=12800000&amp;guid=7d44473115e622a4ea5717417f60c41d&amp;type=3#Mobile_Pretendard-SemiBold&apos;); -unity-font-definition: url(&quot;project://database/Assets/Fonts/Pretendard-SemiBold.otf?fileID=12800000&amp;guid=c5f2f18448a7a8340af7b5afdab1df03&amp;type=3#Pretendard-SemiBold&quot;); margin-bottom: 6px;" />
                    <ui:VisualElement name="edit-button" style="flex-grow: 0; flex-shrink: 0; width: 40px; height: 40px; border-top-left-radius: 20px; border-top-right-radius: 20px; border-bottom-right-radius: 20px; border-bottom-left-radius: 20px; background-color: rgba(195, 220, 255, 0.1); align-items: center; justify-content: center; position: absolute; right: 15px;">
                        <ui:VisualElement name="icon" style="flex-grow: 0; flex-shrink: 0; width: 20px; height: 20px; background-image: resource(&apos;Vectors/Icons/edit&apos;); -unity-background-scale-mode: scale-to-fit;" />
