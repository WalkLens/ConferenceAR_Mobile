            <ui:VisualElement name="divider" class="divider" />
            <ui:VisualElement name="URL" style="padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px;">
                <ui:VisualElement name="header" style="flex-grow: 1; flex-direction: row; align-items: center;">
                    <ui:Label text="URL" display-tooltip-when-elided="true" name="header-label" style="font-size: 16px; -unity-font: url(&apos;project://database/Assets/Fonts_Mobile/Mobile_Pretendard-SemiBold.otf?fileID=12800000&amp;guid=7d44473115e622a4ea5717417f60c41d&amp;type=3#Mobile_Pretendard-SemiBold&apos;); -unity-font-definition: url(&quot;project://database/Assets/Fonts/Pretendard-SemiBold.otf?fileID=12800000&amp;guid=c5f2f18448a7a8340af7b5afdab1df03&amp;type=3#Pretendard-SemiBold&quot;); margin-bottom: 6px; margin-right: 0;" />
                    <ui:Label text="(선택)" display-tooltip-when-elided="true" name="header-label-small" style="font-size: 14px; -unity-font: url(&apos;scale-and-crop&apos;); color: rgb(143, 143, 143); margin-bottom: 6px;" />
                </ui:VisualElement>
                <ui:VisualElement name="chip-container" style="flex-grow: 1; flex-wrap: wrap; flex-direction: row;">
                    <ui:Button text="+" name="add-url-button" class="chip chip-add" style="background-color: rgb(57, 118, 242);" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="modal-background" style="flex-grow: 0; position: absolute; flex-shrink: 0; width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0.59); display: none;" />
