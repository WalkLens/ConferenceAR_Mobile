            <ui:VisualElement name="modal-bar" style="flex-grow: 1; width: 40px; height: 5px; background-color: rgb(255, 255, 255); border-top-left-radius: 2.5px; border-top-right-radius: 2.5px; border-bottom-right-radius: 2.5px; border-bottom-left-radius: 2.5px; position: absolute; align-self: center; top: 10px;" />
            <ui:Label text="개인 URL (선택)" name="modal-header" style="font-size: 16px; -unity-font-definition: url(&quot;project://database/Assets/Fonts/Pretendard-SemiBold.otf?fileID=12800000&amp;guid=c5f2f18448a7a8340af7b5afdab1df03&amp;type=3#Pretendard-SemiBold&quot;); margin-top: 29px;" />
