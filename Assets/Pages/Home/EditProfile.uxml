                <ui:VisualElement name="interest-chip-container" style="flex-grow: 1; flex-wrap: wrap; flex-direction: row;">
                    <ui:Button text="+" name="add-interest-button" class="chip chip-add" style="background-color: rgb(57, 118, 242);" />
                </ui:VisualElement>
